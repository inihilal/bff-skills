# Required environment variables for hodlmm-bin-migrator
# Copy this file to .env and fill in your values.

# REQUIRED: Your Stacks mainnet address (must start with SP)
# Used as the transaction sender for migrate and auto-rebalance commands.
# The tool will exit with an error if this is not set.
STX_ADDRESS=your_stacks_address_here

# REQUIRED for write commands (migrate, auto-rebalance):
# Your Stacks private key (hex-encoded).
# Never commit this value -- keep it in .env only.
STX_PRIVATE_KEY=your_private_key_here
