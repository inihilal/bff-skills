# =============================================================================
# yield-rotator -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: Stacks wallet credentials
STACKS_PRIVATE_KEY=your_stacks_private_key_hex_here
STACKS_ADDRESS=your_stacks_address_SP_here

# Optional: Hiro API key (for higher rate limits)
HIRO_API_KEY=

# Optional: Default network (mainnet | testnet)
STACKS_NETWORK=mainnet

# Optional: HODLMM pool to monitor/trade (default: dlmm_1)
HODLMM_POOL_ID=dlmm_1

# Optional: Yield gap threshold in percent (default: 2.0)
GAP_THRESHOLD_PCT=2.0

# Optional: Minimum USDh amount to consider rotating (default: 10)
MIN_ROTATE_AMOUNT_USDH=10
